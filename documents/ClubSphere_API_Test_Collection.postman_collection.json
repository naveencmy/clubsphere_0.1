    {
      "name": "04. A/B Testing & Real Experimentation",
      "item": [
        {
          "name": "GET /api/experiments - List Active Experiments",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/experiments", "host": ["{{baseUrl}}"], "path": ["api", "experiments"] },
            "description": "Returns active experiments registered with locked hypotheses and primary metrics."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.expect(res.success).to.be.true;",
                  "pm.expect(res.data.length).to.be.at.least(1);",
                  "var exp = res.data.find(e => e.key === 'EXP_MERCH_MEMBERSHIP_UPSELL');",
                  "pm.expect(exp).to.be.ok;",
                  "pm.expect(exp.hypothesis.primary).to.be.undefined;",
                  "pm.expect(exp.metrics.primary).to.eql('cart_to_paid_conversion_rate');"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/experiments/:key/evaluate - Evaluate Variant Assignment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/experiments/EXP_MERCH_MEMBERSHIP_UPSELL/evaluate?participantId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "experiments", "EXP_MERCH_MEMBERSHIP_UPSELL", "evaluate"],
              "query": [
                { "key": "participantId", "value": "{{userId}}" }
              ]
            },
            "description": "Performs deterministic SHA-256 hash modulo 100 bucketing to assign participant to CONTROL or TREATMENT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.expect(res.data.experimentKey).to.eql('EXP_MERCH_MEMBERSHIP_UPSELL');",
                  "pm.expect(res.data.variant).to.be.oneOf(['CONTROL', 'TREATMENT']);",
                  "pm.expect(res.data.bucket).to.be.within(0, 99);",
                  "pm.environment.set('assigned_variant', res.data.variant);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/experiments/:key/track - Track Conversion Event",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metricName\": \"cart_to_paid_conversion_rate\",\n  \"value\": 1,\n  \"participantId\": \"{{userId}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/experiments/EXP_MERCH_MEMBERSHIP_UPSELL/track", "host": ["{{baseUrl}}"], "path": ["api", "experiments", "EXP_MERCH_MEMBERSHIP_UPSELL", "track"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.expect(res.data.variant).to.eql(pm.environment.get('assigned_variant'));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
