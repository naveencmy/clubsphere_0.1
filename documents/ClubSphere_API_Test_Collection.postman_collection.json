  "item": [
    {
      "name": "01. System Health & Observability",
      "item": [
        {
          "name": "GET /health - API Gateway Liveness Probe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] },
            "description": "Verifies that the ClubSphere Express API gateway is responsive, instruments X-Request-Id, and returns healthy payload."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response contains UP status and gateway service name', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('UP');",
                  "    pm.expect(json.service).to.eql('ClubSphere API Gateway');",
                  "});",
                  "pm.test('Observability headers present', function () {",
                  "    pm.expect(pm.response.headers.get('X-Request-Id')).to.be.ok;",
                  "    pm.expect(pm.response.headers.get('X-ClubSphere-Service')).to.eql('ClubSphere-API');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /health/ready - PostgreSQL Readiness Probe",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health/ready", "host": ["{{baseUrl}}"], "path": ["health", "ready"] },
            "description": "Validates database connectivity to PostgreSQL pool and reports database timestamp."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 503 depending on live DB', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 503]);",
                  "});",
                  "pm.test('Payload contains database health object', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('database');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Authentication & Student Identity",
      "item": [
        {
          "name": "POST /api/auth/register - Register Student Account",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student_tester_\" + Date.now() + \"@campus.edu\",\n  \"password\": \"SecurePass123!\",\n  \"fullName\": \"Naveen Krishna\",\n  \"studentId\": \"STU\" + Math.floor(100000 + Math.random() * 900000)\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uniqueEmail = 'student_' + Date.now() + '@campus.edu';",
                  "var studentId = 'STU' + Math.floor(100000 + Math.random() * 900000);",
                  "pm.environment.set('temp_email', uniqueEmail);",
                  "pm.environment.set('temp_student_id', studentId);",
                  "pm.request.body.raw = JSON.stringify({",
                  "  email: uniqueEmail,",
                  "  password: 'Password123!',",
                  "  fullName: 'Student Tester',",
                  "  studentId: studentId",
                  "});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.environment.set('token', res.data.token);",
                  "    pm.environment.set('userId', res.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login - Authenticate User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{temp_email}}\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.environment.set('token', res.data.token);",
                  "    pm.environment.set('userId', res.data.user.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me - Verify Current Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.expect(res.success).to.be.true;",
                  "pm.expect(res.data.id).to.eql(pm.environment.get('userId'));"
